# Manual application authentication
AUTH_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
ADMIN_NAME=Administrator
ADMIN_OTP_SECRET=replace_with_a_random_secret_at_least_32_characters

# Firebase Realtime Database (server-side only; Firebase Authentication is NOT used)
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

# Gmail API - used for Admin OTP, password-reset OTP and application emails
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Razorpay Test Mode - server-side only
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to 1 only for local development without Razorpay; it does NOT create successful fake payments
MOCK_GATEWAY=0
