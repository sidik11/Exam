# Firebase Web config (safe for frontend; still keep .env out of git)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin bootstrap (optional but recommended for first local run)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Gmail API OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_SENDER_EMAIL=

# Razorpay Test Mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment server
PAYMENT_GATEWAY_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
PAYMENT_PORT=4000

# Set to 1 only if you intentionally want mock orders instead of Razorpay Checkout
MOCK_GATEWAY=0

# Main app
PORT=3000
